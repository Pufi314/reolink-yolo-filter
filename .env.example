# IMAP inbox receiving Reolink camera alerts (IMAP over TLS, normally port 993).
IMAP_SERVER=imap.example.com
IMAP_USER=camera-alerts@example.com
IMAP_PASSWORD=replace-with-an-app-password

# Authenticated SMTP submission with STARTTLS (normally port 587).
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASSWORD=replace-with-an-app-password
TARGET_EMAIL=you@example.com

# Detection confidence in the inclusive range 0.0-1.0.
CONFIDENCE_THRESHOLD=0.5

# Set these to a NAS user/group that can write to ./data/model-cache.
PUID=1026
PGID=100

# Optional polling/reconnect tuning.
POLL_INTERVAL_SECONDS=15
RECONNECT_DELAY_SECONDS=30
